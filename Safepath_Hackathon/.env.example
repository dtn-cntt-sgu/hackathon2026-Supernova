# Local defaults. For production use the standalone compose and deployment guide.
APP_ENV=development
# Generate independently with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
SERVICE_AUTH_TOKEN=
MAX_REQUEST_BODY_BYTES=262144
# Empty unless the reverse proxy network has been explicitly restricted.
TRUSTED_PROXY_IPS=[]

# Host backend: use localhost. Compose backend: service overrides with osrm/postgis/redis names.
DATABASE_URL=postgresql+asyncpg://safepath_user:replace-with-local-password@localhost:5432/safepath_db
REDIS_URL=redis://localhost:6379/0
OSRM_BASE_URL=http://localhost:5000
OSRM_HOST_PORT=5000
# Build-produced proof; do not fabricate a manifest for existing graph files.
OSRM_GRAPH_MANIFEST_PATH=data/osrm/graph-manifest.json
OSRM_GRAPH_VERSION=
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Keep camera ingestion disabled until source permission and coordinates are verified.
USE_MOCK_CAMERA_FALLBACK=False
HCMC_CAMERA_COOKIE=
LLM_API_KEY=

# Viewing permission never grants permission to use camera evidence for routing.
CAMERA_INGESTION_PERMITTED=false
CAMERA_ALLOW_VIEW_ONLY=true
CAMERA_ROUTING_EVIDENCE_PERMITTED=false
CAMERA_AI_MODE=route_only
ROUTE_CAMERA_AI_ENABLED=true
ROUTE_AI_MAX_CAMERAS=4
ROUTE_AI_MAX_CONCURRENCY=2
ROUTE_AI_TIMEOUT_SECONDS=8
ROUTE_AI_CACHE_TTL_SECONDS=300
ROUTE_AI_MAX_FRAME_AGE_SECONDS=120

# Commercial Real-Time Traffic Providers (Optional, Zero-Mock Fallback to UNKNOWN if omitted)
# TRAFFIC_PROVIDER options: auto (default), tomtom, here
TRAFFIC_PROVIDER=auto
TOMTOM_API_KEY=
HERE_API_KEY=
TRAFFIC_CACHE_TTL_SECONDS=180
TRAFFIC_REQUEST_TIMEOUT_SECONDS=3.0

# Original camera reverse proxy (separate from route analysis).
CAMERA_PROXY_ENABLED=true
# Explicitly selected viewing source; no fallback on provider rejection.
CAMERA_PROXY_PROVIDER=vietmap
CAMERA_PROXY_CACHE_TTL_SECONDS=20
CAMERA_PROXY_STALE_MAX_SECONDS=120
CAMERA_PROXY_MAX_CACHED_FRAMES=32
CAMERA_PROXY_MAX_PENDING=64
CAMERA_PROXY_MAX_PIXELS=4194304
CAMERA_PROXY_MAX_BYTES=3000000
CAMERA_PROXY_MAX_CONCURRENCY=4
CAMERA_PROXY_TIMEOUT_SECONDS=8
CAMERA_PROXY_FAILURE_BACKOFF_SECONDS=60
CAMERA_PROXY_MIN_REQUEST_INTERVAL_SECONDS=0.25

# Run observational inference only on explicit Overlay/inspection interaction.
CAMERA_VIEW_AI_ENABLED=true
CAMERA_VIEW_AI_TIMEOUT_SECONDS=20

# Official HCMC daily tide bulletin (observed extrema and forecasts, never instant level).
HYDROLOGY_BULLETIN_ENABLED=true
HYDROLOGY_BULLETIN_POLL_SECONDS=1800
HYDROLOGY_BULLETIN_TIMEOUT_SECONDS=10
HYDROLOGY_BULLETIN_MAX_BYTES=3000000
HYDROLOGY_BULLETIN_MAX_AGE_HOURS=36
